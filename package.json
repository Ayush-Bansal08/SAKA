{
  "name": "warden",
  "private": true,
  "description": "Warden — an AI DeFi agent (0G · Uniswap).",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev dev:worker dev:bot --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @warden/api db:migrate",
    "db:migrate:dev": "pnpm --filter @warden/api db:migrate:dev",
    "db:studio": "pnpm --filter @warden/api db:studio",
    "db:seed": "pnpm --filter @warden/api db:seed",
    "smoke:uniswap": "node --env-file=.env scripts/smoke/uniswap-routes.mjs",
    "smoke:mcp": "pnpm --filter uniswap-agent-mcp exec tsx ../../scripts/smoke/mcp.ts",
    "smoke:privy": "pnpm --filter @warden/api exec tsx --conditions=@warden/source ../../scripts/smoke/privy.ts",
    "check:sources": "pnpm --filter uniswap-agent-mcp check:sources",
    "smoke:zg": "pnpm --filter @warden/api exec tsx --conditions=@warden/source ../../scripts/smoke/zg.ts",
    "smoke:zgstorage": "pnpm --filter @warden/api exec tsx --conditions=@warden/source ../../scripts/smoke/zgstorage.ts",
    "eval:planner": "pnpm --filter @warden/api exec tsx --conditions=@warden/source eval/planner.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "tsx": "4.23.15"
  },
  "pnpm": {
    "overrides": {
      "@uniswap/sdk-core": "7.19.4",
      "@uniswap/v3-sdk": "3.31.5"
    }
  }
}
