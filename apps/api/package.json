{
  "name": "@warden/api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@warden/source --clear-screen=false src/server.ts",
    "dev:worker": "tsx watch --conditions=@warden/source --clear-screen=false src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:server": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:seed": "dotenv -e ../../.env -- tsx --conditions=@warden/source prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.4.1",
    "@fastify/rate-limit": "11.2.2",
    "@prisma/client": "6.19.3",
    "@warden/shared": "workspace:*",
    "bullmq": "5.81.5",
    "decimal.js": "10.6.0",
    "dotenv": "17.4.2",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "4.0.2",
    "ioredis": "5.11.1",
    "pino": "9.14.0",
    "prisma": "6.19.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "dotenv-cli": "8.0.0",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
