# =============================================================================
# Warden — environment variables
# Copy to `.env` in the repo root (never commit `.env`). The API and worker load
# it automatically in development; production platforms inject real env vars.
# Every variable used anywhere in the repo is listed here with a comment.
# =============================================================================

# --- core (PHASE 01) ---------------------------------------------------------
# development | test | production
NODE_ENV=development
# API HTTP port (web expects 3001 in dev)
PORT=3001
# Interface the API binds to
HOST=0.0.0.0
# Product name shown in the UI (rename freely; nothing else depends on it)
APP_NAME=SAKA
# Exact origin of the web app — the only origin allowed by CORS
WEB_URL=http://localhost:5173
# Public base URL of this API
API_URL=http://localhost:3001
# Postgres 16 (docker compose provides this locally)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/warden
# Redis 7 (sessions pub/sub, BullMQ, rate limits)
REDIS_URL=redis://localhost:6379
# 32 random bytes, base64 — encrypts secrets at rest. Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Bearer session lifetime in hours (default 168 = 7 days)
SESSION_TTL_HOURS=168
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Set true on a hosted non-production deploy behind a proxy (always on in production)
# TRUST_PROXY=true
# pretty (default in development) | json — hosted images must use json (pino-pretty is dev-only)
# LOG_FORMAT=json
# The ONE testnet the agent executes on: 11155111 (Ethereum Sepolia, recommended) | 1301 (Unichain Sepolia)
# | 84532 (Base Sepolia — not routable on the Uniswap API as of 2026-11-06, see FEEDBACK.md)
EXECUTION_CHAIN_ID=11155111

# --- identity & approval modes ------------------------------------------------
# dev | passkey — both must match; dev providers are refused when NODE_ENV=production
AUTH_MODE=dev
APPROVAL_MODE=dev
# Must be true to use dev providers (and is forbidden in production)
ALLOW_DEV_PROVIDERS=true
# Passkeys are locked to this domain. Defaults to the WEB_URL hostname.
# WEBAUTHN_RP_ID=

# --- admin -------------------------------------------------------------------
# Long random token for admin endpoints (>= 24 chars). Generate: openssl rand -hex 32
ADMIN_TOKEN=

# --- tests (optional) --------------------------------------------------------
# Test suite database/redis (defaults shown; CI sets these)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/warden_test
# TEST_REDIS_URL=redis://localhost:6379/1

# --- container entry (deploy) ------------------------------------------------
# Selects the backend process in the Docker image: server | worker | bot
# PROCESS_TYPE=server

# --- web (apps/web, Vite — set in Vercel for production) ---------------------
# Base URL of the API as seen from the browser
VITE_API_URL=http://localhost:3001

# --- Uniswap (PHASE 02) ------------------------------------------------------
# Uniswap Developer Platform key (Trading API + LP API), sent as `x-api-key`
UNISWAP_API_KEY=
# Trading API base (/quote, /swap, /check_approval) — matches `servers` in the OpenAPI spec
UNISWAP_API_BASE_URL=https://trade-api.gateway.uniswap.org/v1
# LP API base (/lp/*), no version prefix
UNISWAP_LP_API_BASE_URL=https://liquidity.api.uniswap.org
# The Graph gateway key for the Uniswap v4 subgraph
THEGRAPH_API_KEY=
# Official Uniswap v4 mainnet subgraph (read-only market data; first source in every failover chain)
UNISWAP_V4_SUBGRAPH_ID=DiYPVdygkfjDWhbxGSqAQxwBKmfKnkWQojqeM2rkLb3G
# Fallback v4 pool registry subgraph (Initialize events: pools, hooks, fees). Empty disables it.
UNISWAP_V4_POOL_REGISTRY_SUBGRAPH_ID=6XvRX3WHSvzBVTiPdF66XSBVbxWuHqijWANbjJxRDyzr
# Third-party last-resort fallback for TVL / volume / candles (GeckoTerminal, no key)
GECKOTERMINAL_ENABLED=true
# Seconds a failed market-data source is skipped before retrying (ms)
MARKET_SOURCE_COOLDOWN_MS=60000
# RPC endpoints: mainnet (read-only market data) and the execution testnet
MAINNET_RPC_URL=
EXECUTION_RPC_URL=
# Contract source verification lookups for the hook explorer (optional; Etherscan v2 multichain)
ETHERSCAN_API_KEY=
# x-agent-info decision_origin sent to the Uniswap API: autonomous | human_mediated
UNISWAP_DECISION_ORIGIN=autonomous
# Pools never to route through on the execution chain; turns on per-trade route selection.
# Ethereum Sepolia: both v3 ETH/USDC pools quote well, then revert with TF at execution.
# UNISWAP_BLOCKED_POOLS=0x3289680dD4d6C10bb19b899729cda5eEF58AEfF1,0xFeEd501c2B21D315F04946F85fC6416B640240b5
# Universal Router version header (2.0 / 2.1.1 were sunset on 2026-10-21): 2.1.2 | 2.2.0
UNISWAP_UNIVERSAL_ROUTER_VERSION=2.1.2
# Extra allowlisted tokens beyond ETH/WETH/USDC (JSON array, verify addresses on-chain first), e.g.
# [{"chainId":11155111,"address":"0x…","symbol":"LINK","decimals":18,"referenceSymbol":"LINK"}]
TOKEN_ALLOWLIST_JSON=

# --- Uniswap agent MCP server (PHASE 02) -------------------------------------
# Bearer token the API uses to call the MCP server. Generate: openssl rand -hex 24
MCP_AUTH_TOKEN=
# HMAC key for build-tool resumeTokens (NEEDS_SIGNATURE → finalize). Generate: openssl rand -hex 32
MCP_RESUME_SECRET=
# Where the API reaches the MCP server (streamable HTTP endpoint)
MCP_URL=http://localhost:3002/mcp
# MCP HTTP port (pnpm dev passes --port 3002; Railway sets PORT)
MCP_PORT=3002
# Requests per minute per bearer token on the MCP HTTP transport
MCP_RATE_LIMIT_PER_MIN=600

# --- agent wallets, onboarding, portfolio (PHASE 03) -------------------------
# Privy app credentials (dashboard → App settings). Agent wallets are app-controlled server
# wallets; without these, POST /onboarding/wallet answers 503 WALLET_PROVIDER_ERROR.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: only if your Privy dashboard requires signed requests (authorization key,
# "wallet-auth:..." PKCS8). Leave empty otherwise — everything works without it.
PRIVY_AUTHORIZATION_PRIVATE_KEY=
# Testnet ETH faucet shown in onboarding (default: Google Cloud Sepolia faucet for 11155111)
FAUCET_ETH_URL=
# Testnet USDC faucet shown in onboarding
FAUCET_USDC_URL=https://faucet.circle.com
# Balance watcher: poll interval for active users, and for users inactive > 24 h (ms)
BALANCE_POLL_MS=15000
BALANCE_POLL_INACTIVE_MS=300000
# (EXECUTION_RPC_URL above is also used by `pnpm smoke:privy`; TOKEN_ALLOWLIST_JSON and
#  UNISWAP_UNIVERSAL_ROUTER_VERSION also shape the Privy wallet policy allowlist.)

# --- 0G inference ----------------------------------------------------------
# 0G Router (PHASE 04)
ZG_API_KEY=
ZG_BASE_URL=https://router-api.0g.ai/v1
ZG_MODEL_PLANNER=glm-5.3
ZG_MODEL_PLANNER_FALLBACK=0gm-1.0-35b-a3b
# Guard transport: decisions (Vela via /v1/decisions, default) | chat (ZG_MODEL_GUARD via
# /v1/chat/completions with a strict JSON verdict — use with a chat model when Vela is down).
ZG_GUARD_MODE=decisions
# With ZG_GUARD_MODE=decisions, ZG_MODEL_GUARD is a decisions model (POST /decisions).
ZG_MODEL_GUARD=vela-2.0-9b
ZG_MODEL_EXPLAINER=0gm-1.0-35b-a3b
# Timeout per 0G HTTP attempt; failed primary planner calls use the configured fallback.
ZG_PLANNER_TIMEOUT_MS=12000
# Timeout per guard (/decisions) and explainer call.
ZG_REQUEST_TIMEOUT_MS=20000
# Trust tier of the planner fallback: verified (PHASE_00 default). A key limited to `private`
# answers 403 trust_mode_mismatch on `verified`; set `private` (a stricter tier) for such keys.
ZG_PLANNER_FALLBACK_TRUST_MODE=verified
# reasoning_effort for chat models (off | low | medium | high). `low` keeps GLM-5.3 tool rounds
# well inside ZG_PLANNER_TIMEOUT_MS; `off` omits the field.
ZG_REASONING_EFFORT=low
# --- safety, approvals, execution (PHASE 05) ----------------------------------
# How long a step-up approval stays valid, in seconds (PHASE_00 §9 default: 300)
APPROVAL_TTL_SECONDS=300
# Visible countdown before an AUTO action is queued; Cancel works during it (ms)
AUTO_EXECUTE_DELAY_MS=3000
# Receipt wait per broadcast tx before the job re-checks it by hash (never re-sends) (ms)
RECEIPT_TIMEOUT_MS=90000
# (EXECUTION_RPC_URL above is required for simulation: without it every action is refused.)

# --- 0G Storage decision log (PHASE 05) -------------------------------------
# Funded 0G Galileo testnet key that pays for decision-log uploads (faucet: faucet.0g.ai).
# Without it, decision logs are kept in Postgres with status PENDING and not uploaded.
ZG_STORAGE_PRIVATE_KEY=
ZG_STORAGE_RPC=https://evmrpc-testnet.0g.ai
ZG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
# 0G chain explorer for decision-log links: <base>/tx/<zgTxHash>
ZG_STORAGE_EXPLORER_URL=https://chainscan-galileo.0g.ai
# --- Mode B & Telegram (PHASE 08) ---------------------------------------------
# From @BotFather. Without it alerts stay in the web inbox and the bot does not start.
TELEGRAM_BOT_TOKEN=
# The bot's username without "@" (used for the t.me link in Settings)
TELEGRAM_BOT_USERNAME=
# Production only: Telegram calls API_URL/telegram/webhook with this secret. 16-256 of A-Z a-z 0-9 _ -
# Locally the bot long-polls and this stays empty. Generate: openssl rand -hex 32
# TELEGRAM_WEBHOOK_SECRET=
# Time budget for one Mode B pass over all users (ms); the rest go first next tick
# MODEB_TICK_BUDGET_MS=45000
# Demo market simulator (Inbox > Demo). Off: no button, and its routes answer 404.
# ENABLE_DEMO_SIMULATOR=true
