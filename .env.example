# =============================================================================
# Warden — environment variables
# Copy to `.env` in the repo root (never commit `.env`). The API and worker load
# it automatically in development; production platforms inject real env vars.
# Every variable used anywhere in the repo is listed here with a comment.
# =============================================================================

# --- core (PHASE 01) ---------------------------------------------------------
# development | test | production
NODE_ENV=development
# API HTTP port (web expects 3001 in dev)
PORT=3001
# Interface the API binds to
HOST=0.0.0.0
# Product name shown in the UI (rename freely; nothing else depends on it)
APP_NAME=Warden
# Exact origin of the web app — the only origin allowed by CORS
WEB_URL=http://localhost:5173
# Public base URL of this API
API_URL=http://localhost:3001
# Postgres 16 (docker compose provides this locally)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/warden
# Redis 7 (sessions pub/sub, BullMQ, rate limits)
REDIS_URL=redis://localhost:6379
# 32 random bytes, base64 — encrypts secrets at rest. Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Bearer session lifetime in hours (default 168 = 7 days)
SESSION_TTL_HOURS=168
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# pretty (default in development) | json
# LOG_FORMAT=json
# The ONE testnet the agent executes on: 11155111 (Ethereum Sepolia, recommended) | 1301 (Unichain Sepolia)
# | 84532 (Base Sepolia — not routable on the Uniswap API as of 2026-11-06, see FEEDBACK.md)
EXECUTION_CHAIN_ID=11155111

# --- identity & approval modes (PHASE 01; World arrives in PHASE 10) ----------
# dev | world — dev providers are refused when NODE_ENV=production
AUTH_MODE=dev
APPROVAL_MODE=dev
# Must be true to use dev providers (and is forbidden in production)
ALLOW_DEV_PROVIDERS=true

# --- admin -------------------------------------------------------------------
# Long random token for admin endpoints (>= 24 chars). Generate: openssl rand -hex 32
ADMIN_TOKEN=

# --- tests (optional) --------------------------------------------------------
# Test suite database/redis (defaults shown; CI sets these)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/warden_test
# TEST_REDIS_URL=redis://localhost:6379/1

# --- container entry (deploy) ------------------------------------------------
# Selects the backend process in the Docker image: server | worker | bot
# PROCESS_TYPE=server

# --- web (apps/web, Vite — set in Vercel for production) ---------------------
# Base URL of the API as seen from the browser
VITE_API_URL=http://localhost:3001

# --- added by later phases (not read yet) ------------------------------------
# Uniswap API / LP API key (PHASE 02)
UNISWAP_API_KEY=
# 0G Router (PHASE 04)
ZG_API_KEY=
ZG_BASE_URL=https://router-api.0g.ai/v1
# Privy server wallets (PHASE 03)
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# 0G Storage decision log (PHASE 07)
ZG_STORAGE_PRIVATE_KEY=
ZG_STORAGE_RPC=https://evmrpc-testnet.0g.ai
ZG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
# Telegram bot (PHASE 08)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# The Graph gateway key for the Uniswap v4 subgraph (PHASE 02)
THEGRAPH_API_KEY=
# Contract source verification lookups (hook explorer)
ETHERSCAN_API_KEY=
# RPC endpoints: mainnet (read-only market data) and the execution testnet
MAINNET_RPC_URL=
EXECUTION_RPC_URL=
